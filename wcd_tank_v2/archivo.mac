# Inicializa la simulación
/run/initialize

# Configuración de la fuente de partículas usando GPS

# Tipo de partícula: puedes cambiar "mu+" a otra partícula como "gamma", "e-", "proton", etc.
/gps/particle mu+

# Energía de la partícula: 1 GeV
/gps/energy 1 GeV

# Posición de la fuente: Coloca la fuente de partículas en el punto (0, 3, 0) metros
/gps/position 0 3 0 m

# Dirección de la partícula: Hacia abajo en el eje Y negativo
/gps/direction 0 -1 0

# Configuración de la emisión desde una superficie circular de 1 metro de radio
/gps/pos/type Circle
/gps/pos/radius 1 m

# Distribución angular: isotrópica en todas las direcciones
/gps/ang/type iso

# Generar 1000 eventos
/run/beamOn 1000
